# Local development needs NONE of these: the Functions emulator only needs a
# projectId, which is hard-coded to cac-medical-project in src/firebase.ts.
#
# Fill these in from the Firebase console (Project settings → Your apps) only
# when you are ready to build for a real deploy. Copy this file to .env.local,
# which is gitignored.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=cac-medical-project
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=387415616698
VITE_FIREBASE_APP_ID=

# Override only if your emulator runs somewhere unusual.
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001
