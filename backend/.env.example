# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored. Never commit a real key.

# Anthropic API key, used by /extract, /explain and /draft.
ANTHROPIC_API_KEY=

# Fax provider key (Phaxio or SRFax). Not needed until week 5.
FAX_API_KEY=

# Comma separated list of addresses allowed to call this server.
# "*" is fine while developing on your own wifi. Set a real address before deploying.
ALLOWED_ORIGINS=*
